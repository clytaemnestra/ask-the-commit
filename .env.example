# Copy to .env and fill in. Everything has a working default except GROQ_API_KEY.
#   cp .env.example .env

# --- Generation backend -------------------------------------------------------
# groq   : free hosted open-weight models (default)    -> needs GROQ_API_KEY
#          free tier is capped at 8k tokens/minute, so eval runs are paced by
#          the provider's Retry-After hints rather than run flat out
# ollama : fully local, no key                         -> needs a running ollama
# openai : paid, same wire format                      -> needs OPENAI_API_KEY
# echo   : no model at all; echoes retrieved context   -> for offline testing
LLM_PROVIDER=groq

# Free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Used only when LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Used only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# --- Paths --------------------------------------------------------------------
EPISODES_DIR=episodes
DATA_DIR=data
COLLECTION_NAME=podcast_chunks

# --- Transcription (faster-whisper, local) ------------------------------------
# tiny | base | small | medium | large-v3  (bigger = slower, more accurate)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leave blank to autodetect, or pin e.g. en for a small speed/accuracy win.
WHISPER_LANGUAGE=

# Domain vocabulary that biases transcription. Whisper resolves homophones to the
# commoner general-English spelling unless told the domain exists — it hears
# "cubes OS" for "Qubes OS" and "Viator" for "via Tor" without this. Max ~224
# tokens. Changing it invalidates cached transcripts.
WHISPER_INITIAL_PROMPT=

# --- Embeddings ---------------------------------------------------------------
# The question has to be embedded at query time (it does not exist until someone
# asks it, so it cannot be precomputed).
#
# onnx   : DEFAULT. Runs the committed MiniLM export through ONNX Runtime.
#          Local, no API key, ~90MB resident, ~3ms per query. Same model as
#          sentence-transformers, without torch's ~830MB.
# local  : sentence-transformers in-process. Identical vectors, ~830MB resident.
#          Ingest/dev only; needs requirements-ingest.txt.
# jina   : hosted, free tier, no card -> https://jina.ai/embeddings/
# google : hosted, free tier          -> https://aistudio.google.com/apikey
# openai : hosted, paid               -> https://platform.openai.com/api-keys
#
# IMPORTANT: whichever embedder builds the index must also serve queries.
# Document and question vectors have to come from the same model, or retrieval
# degrades silently. The index records its embedder in data/index/manifest.json
# and the service refuses to start on a mismatch.
EMBEDDING_PROVIDER=onnx

# Only needed for the hosted providers. Leave blank for onnx/local.
EMBEDDING_API_KEY=
# Leave blank to use the provider's default model.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_S=30
EMBEDDING_MAX_RETRIES=3

# --- Vector store -------------------------------------------------------------
# numpy  : committed data/index/*.npy, read-only, no server (deployment default)
# chroma : local Chroma database (needs requirements-ingest.txt)
VECTOR_STORE=numpy

# --- Chunking -----------------------------------------------------------------
# Measured in embedding-model tokens. all-MiniLM-L6-v2 truncates at 256, hence
# 220. Hosted embedding models accept 8k+, so if you ingest with a hosted
# provider you can raise this considerably — see the README.
CHUNK_TOKENS=220
CHUNK_OVERLAP_TOKENS=40

# --- Retrieval ----------------------------------------------------------------
TOP_K=5
# Cosine-similarity floor: below this the service refuses without calling the
# model. Set to -1 to always generate.
MIN_SCORE=0.20

# --- Answer cache -------------------------------------------------------------
# Repeat questions are common on a demo link, and a repeat otherwise costs ~1.5s
# of generation plus Groq quota. In-memory only, so a cold start begins empty.
# Set to 0 to disable.
ANSWER_CACHE_SIZE=256
# Optional entry lifetime in seconds. Blank = keep until evicted, which is right
# here because answers only change when the index or model does, and both of
# those restart the process.
ANSWER_CACHE_TTL_S=

# --- Observability ------------------------------------------------------------
LOG_LEVEL=INFO
# json for machine-readable logs, text for readable local development
LOG_FORMAT=json

# --- Deployment ---------------------------------------------------------------
# Render injects $PORT and the start command passes it to uvicorn; do not set it
# here. API_PORT only affects `python main.py` locally.
API_PORT=8000

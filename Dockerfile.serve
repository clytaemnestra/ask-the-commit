# Query-only image, for hosts that run containers (Cloud Run, Fly, a VPS).
# Render does not need this — see DEPLOY.md for the simpler Python runtime path.
#
# Ships no ML framework: the index is a committed NumPy array and the question is
# embedded by ONNX Runtime against the committed MiniLM export, so there is no
# torch, no chromadb and no faster-whisper in the image.
#
#   docker build -f Dockerfile.serve -t ask-the-commit-serve .
#   docker run -p 7860:7860 --env-file .env ask-the-commit-serve
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=7860

RUN useradd --create-home --uid 1000 app
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY rag.py main.py ./
# The two committed artifacts the service cannot start without. Build fails
# loudly here rather than at runtime if either is missing from the context.
COPY data/index ./data/index
COPY models/minilm-onnx ./models/minilm-onnx

RUN chown -R app:app /app
USER app
EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import os,urllib.request,sys; sys.exit(0 if urllib.request.urlopen(f\"http://localhost:{os.environ.get('PORT','7860')}/health\", timeout=4).status == 200 else 1)"

# Exec form through sh so $PORT still expands — hosts set it to whatever they
# route to — without losing signal handling.
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-7860}"]
